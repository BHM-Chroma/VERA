; Engine configuration file.
; VERONIKA desktop mate

config_version=5

[application]

config/name="VERONIKA Mate"
config/description="Desktop mate: персонаж на рабочем столе, который следит за ПК"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=520
window/size/viewport_height=640
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
